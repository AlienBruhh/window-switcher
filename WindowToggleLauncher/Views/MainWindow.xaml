<Window x:Class="WindowToggleLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowToggleLauncher.ViewModels"
        Title="Window Toggle Launcher" 
        Height="500" Width="600"
        MinHeight="300" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="10" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
                <Button Content="Add App" Command="{Binding AddAppCommand}" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="Exit" Command="{Binding ExitCommand}" Padding="10,5"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AppButtonViewModel}">
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="10" Margin="5" Width="150" Background="White">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Hotkey}" FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Toggle" Command="{Binding ToggleCommand}" Padding="10,2" Margin="0,0,5,0"/>
                                    <Button Content="Edit" Command="{Binding DataContext.EditAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
