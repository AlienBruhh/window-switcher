<Window x:Class="WindowToggleLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowToggleLauncher.ViewModels"
        Title="DeskDeck - Windows App Switcher &amp; Phone Remote" 
        Height="620" Width="880"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        Background="#1E1E24">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#282830" Padding="15,10" BorderBrush="#3A3A45" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="⚡ DeskDeck" FontWeight="Bold" FontSize="16" Foreground="#F0F0F5" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="➕ Add App" Command="{Binding AddAppCommand}" Background="#007ACC" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0" Padding="12,6" Cursor="Hand"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Exit" Command="{Binding ExitCommand}" Background="#3A3A45" Foreground="#D0D0D5" BorderThickness="0" Padding="12,6" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area: 2 Columns (Apps on Left, QR Remote on Right) -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Apps List -->
            <Border Grid.Column="0" Background="#25252D" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#33333E" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Configured Applications" FontSize="14" FontWeight="Bold" Foreground="#E0E0E8" Margin="0,0,0,12"/>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AppButtonViewModel}">
                                    <Border BorderBrush="#3E3E4C" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,10" Width="170" Background="#2D2D38">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ExecutablePath}" FontSize="9.5" Foreground="#888899" TextWrapping="Wrap" MaxHeight="26" Margin="0,0,0,4"/>
                                            
                                            <!-- Hotkey & Status -->
                                            <Border Background="#1E1E24" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Hotkey, TargetNullValue='No Hotkey'}" FontSize="10" FontWeight="SemiBold" Foreground="#4EC9B0"/>
                                            </Border>

                                            <!-- Actions -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Toggle" Command="{Binding ToggleCommand}" Background="#0E639C" Foreground="White" BorderThickness="0" Padding="0,4" Margin="0,0,3,0" Cursor="Hand"/>
                                                <Button Grid.Column="1" Content="Edit" Command="{Binding DataContext.EditAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#3A3A48" Foreground="#D0D0D8" BorderThickness="0" Padding="0,4" Margin="3,0,0,0" Cursor="Hand"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right: Phone Remote QR Card -->
            <Border Grid.Column="1" Background="#25252D" CornerRadius="8" Padding="15" BorderBrush="#33333E" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📱 Phone Remote Control" FontSize="14" FontWeight="Bold" Foreground="#E0E0E8" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                        <TextBlock Text="Scan with Android camera to connect" FontSize="11" Foreground="#888899" Margin="0,0,0,12" HorizontalAlignment="Center"/>

                        <!-- QR Code Frame -->
                        <Border Background="White" Padding="12" CornerRadius="10" HorizontalAlignment="Center" Margin="0,0,0,12" BorderBrush="#DDDDDD" BorderThickness="1">
                            <Image Source="{Binding QrCodeImage}" Width="190" Height="190" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>

                        <!-- Connection Status Badge -->
                        <Border Background="#1E1E24" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#E5A93C"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPhoneConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding PairingStatus}" FontSize="11.5" FontWeight="SemiBold" Foreground="#E0E0E8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- URL Info Box -->
                        <Border Background="#1E1E24" CornerRadius="4" Padding="8,5" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding ConnectionUrl}" FontSize="9.5" Foreground="#7A9ED2" TextWrapping="Wrap" HorizontalAlignment="Center" ToolTip="Pairing URL for mobile browser"/>
                        </Border>

                        <!-- Action Buttons Grid -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🔄 New QR" Command="{Binding RegenerateQrCommand}" Background="#3A3A48" Foreground="#E0E0E8" BorderThickness="0" Padding="0,6" Margin="0,0,3,0" Cursor="Hand" ToolTip="Generate new pairing code"/>
                            <Button Grid.Column="1" Content="📋 Copy URL" Command="{Binding CopyConnectionUrlCommand}" Background="#3A3A48" Foreground="#E0E0E8" BorderThickness="0" Padding="0,6" Margin="3,0,0,0" Cursor="Hand" ToolTip="Copy connection URL to clipboard"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🌐 Open Test" Command="{Binding OpenWebRemoteCommand}" Background="#2E436E" Foreground="#93C5FD" BorderThickness="0" Padding="0,6" Margin="0,0,3,0" Cursor="Hand" ToolTip="Open remote control in PC browser for testing"/>
                            <Button Grid.Column="1" Content="⛔ Disconnect" Command="{Binding DisconnectPhoneCommand}" Background="#5A2828" Foreground="#FCA5A5" BorderThickness="0" Padding="0,6" Margin="3,0,0,0" Cursor="Hand" ToolTip="Disconnect all paired devices"/>
                        </Grid>

                        <TextBlock Text="💡 Note: Both PC and phone must be on the same local Wi-Fi network." FontSize="10" Foreground="#777788" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
