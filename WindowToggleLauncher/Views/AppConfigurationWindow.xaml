<Window x:Class="WindowToggleLauncher.Views.AppConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Configuration" 
        Height="420" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,5"/>

        <TextBlock Text="Executable:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox x:Name="PathTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,5,5"/>
        <Button Content="Browse" Grid.Row="1" Grid.Column="2" Click="BrowseButton_Click" Width="60"/>

        <TextBlock Text="Arguments:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox x:Name="ArgumentsTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,5"/>

        <TextBlock Text="Hotkey:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox x:Name="HotkeyTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,5,5" ToolTip="Examples: A or Ctrl+Alt+A" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
        <Button x:Name="RegisterHotkeyButton" Content="Register" Grid.Row="3" Grid.Column="2" Click="RegisterHotkeyButton_Click" Width="60"/>

        <TextBlock x:Name="HotkeyCaptureStatusTextBlock" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Foreground="Gray" Margin="0,0,0,5"/>

        <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" Grid.Row="5" Grid.Column="1" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Delete" Click="DeleteButton_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="Save" Click="SaveButton_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="Cancel" Click="CancelButton_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
